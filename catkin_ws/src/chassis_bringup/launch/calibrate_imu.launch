<?xml version="1.0"?>
<launch>
    <!-- 校准imu安装时的一些误差 -->
    <!-- Some errors during calibration of imu installation -->
    <node pkg="imu_calib" type="do_calib" name="do_calib" output="screen" required="True">
       <remap from="/imu" to="/imu/imu_raw"/>
        <param name="output_file" value="$(find chassis_bringup)/param/imu_calib.yaml"/>
    </node>
</launch>
