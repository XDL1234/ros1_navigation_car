<launch>

  <!-- 设置里程计话题起点TF坐标 -->
  <arg name="odom_frame_id"  default="odom_combined"/> 
  <!--选择cartogapher算法时不开启滤波节点-->
  <arg name="is_cartographer" default="false"/>
  <!--打开底盘驱动节点，初始化串口等操作-->
  <node pkg="chassis_bringup" type="chassis_drive_node" name="chassis_drive" output="screen" respawn="false" >
    <!-- <param name="usart_port_name"    type="string" value="$(find chassis_bringup)/../../../.runtime/pts3"/>   -->
    <param name="usart_port_name"    type="string" value="$(find chassis_bringup)/../../../.runtime/pts3"/> 
    <param name="serial_baud_rate"   type="int"    value="115200"/>
    <param name="odom_frame_id"      type="string" value="$(arg odom_frame_id)"/> 
    <param name="robot_frame_id"     type="string" value="base_footprint"/> 
    <param name="gyro_frame_id"      type="string" value="imu_link"/> 

    <!-- 里程计修正参数，对来自运动底盘的速度信息进行手动修正 -->
    <param name="odom_x_scale"      type="double" value="2.06"/> 
    <param name="odom_y_scale"      type="double" value="1.0"/> 
    <param name="odom_z_scale_positive"      type="double" value="2.1"/> 
    <param name="odom_z_scale_negative"      type="double" value="2.1"/> 
  </node>


  <!-- 校准imu安装时的一些误差 -->
  <!-- Some errors during calibration of imu installation -->
  <node pkg="imu_calib" type="apply_calib" name="apply_calib" output="screen" respawn="false">
      <param name="calib_file" value="$(find chassis_bringup)/param/imu_calib.yaml"/>
      <param name="calibrate_gyros" value="true"/>
      <param name="gyro_calib_samples" value="100"/>
      <remap from="/raw" to="/imu/imu_raw"/>
      <remap from="/corrected" to="/imu/imu_calib"/>
  </node>


  <!-- 过滤和融合imu数据 -->
  <!-- Filter and fuse imu data -->
  <node pkg="imu_filter_madgwick" type="imu_filter_node" name="imu_filter_madgwick" output="screen">
      <param name="fixed_frame" value="base_footprint"/>
      <param name="use_mag" value="false"/>
      <param name="publish_tf" value="false"/>
      <param name="world_frame" value="enu"/>
      <remap from="/imu/data_raw" to="/imu/imu_calib"/>
      <remap from="/imu/data" to="/imu/imu_data"/>
  </node>


  <node pkg="imu_complementary_filter" type="complementary_filter_node"
      name="complementary_filter_gain_node" output="screen">
    <param name="fixed_frame" value="base_footprint"/>
    <param name="do_bias_estimation" value="true"/>
    <param name="do_adaptive_gain" value="true"/>
    <param name="use_mag" value="false"/>
    <param name="gain_acc" value="0.01"/>
    <param name="gain_mag" value="0.01"/>
    <remap from="/imu/data_raw" to="/imu/imu_data"/>
    <remap from="/imu/data" to="/imu/imu_data2"/>
  </node>


    <!-- 发布静态坐标系转换 -->
    <!-- Post static coordinate system conversion -->
    <node pkg="tf" type="static_transform_publisher" name="base_link_to_imu_link"
          args="-0.1 0.01 0.01 0 0 0  /base_footprint /imu_link 100" />

    <node
    name="rviz"
    pkg="rviz"
    type="rviz"
    args="-d $(find chassis_bringup)/rviz/calib_imu.rviz" />
</launch>



